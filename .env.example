# PocketAgent Step 2 — environment variables
#
# Copy this file to `.env` and fill in your real values. `.env` is gitignored.
# The code reads from `os.environ` directly; if you prefer `.env` auto-loading,
# `pip install python-dotenv` and call `dotenv.load_dotenv()` in your entry script.

# LLM API key (obtain one from your LLM API provider).
# Paste the raw key; the Authorization header is set to "Bearer {key}".
LLM_API_KEY=your_key_here
